{
  "name": "tusome",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@tusome/web",
    "dev:admin": "turbo dev --filter=@tusome/admin",
    "build": "turbo build",
    "build:web": "turbo build --filter=@tusome/web",
    "build:admin": "turbo build --filter=@tusome/admin",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0"
}
